


<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MetroRasta - Route</title>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>

<body>

<header class="header">
    <h1 class="site-name">MetroRasta</h1>
</header>


<main class="container">

    <div class="route-card">
        <h2 class="route-title">
            <%= source %> <i class="fa-solid fa-arrow-right"></i> <%= destination %>
        </h2>
        <p class="route-summary">
            Total stations = <%= stationMoves %> 
        </p>
        <div
            id="route-data"
            data-english='<%= JSON.stringify(instructions.english) %>'
            data-hinglish='<%= JSON.stringify(instructions.hinglish) %>'
            data-hindi='<%= JSON.stringify(instructions.hindi) %>'
        ></div>
        <div class="language-toggle">
            <button type="button" class="lang-btn active" data-language="english">
                English
            </button>
            <button type="button" class="lang-btn" data-language="hinglish">
                Hinglish
            </button>
            <button type="button" class="lang-btn" data-language="hindi">
                हिंदी
            </button>
        </div>
        <div class="audio-player">
            <button type="button" id="listen-btn" class="audio-play-btn">
                <i class="fa-solid fa-play"></i>
            </button>
            <!-- <span>Listen Audio</span> -->
            <div class="vol-button"><i class="fa-solid fa-volume-high"></i></div>
        </div>
        <ol class="instructions" id="instruction-list">
            <% for (let instruction of instructions.english) { %>
                <li>
                    <%= instruction %>
                </li>
            <% } %>
        </ol>

        <a href="/index" class="back-btn">
            < Go Back
        </a>

    </div>

</main>
<script src="/js/route_path.js"></script>
</body>
</html>
