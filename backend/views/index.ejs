<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MetroRasta</title>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
</head>

<body>

<header class="header">
    <h1 class="site-name">MetroRasta</h1>
</header>


<main class="container">

    <div class="search-card">

        <h2 class="page-title">Find Your Metro Route ( मेट्रो रूट खोजें )</h2>
        <br>

        <form action="/route" method="post">

            <div class="form-group">
                <label for="source">From (शुरू)</label>

                <div class="input-with-mic">
                    <input
                        name="source"
                        id="source"
                        type="text"
                        placeholder="Enter source station"
                        autocomplete="off"
                        required
                    >
                    <button type="button" id="source-mic" class="mic-btn">
                        <i class="fa-solid fa-microphone-slash"></i>
                    </button>
                </div>
                <div id="source-suggestions" class="suggestions"></div>
            </div>


            <div class="form-group">
                <label for="destination">To (खत्म)</label>

                <div class="input-with-mic">
                    <input
                        name="destination"
                        id="destination"
                        type="text"
                        placeholder="Enter destination station"
                        autocomplete="off"
                        required
                    >
                    <button type="button" id="destination-mic" class="mic-btn">
                        <i class="fa-solid fa-microphone-slash"></i>
                    </button>
                </div>
                <div id="destination-suggestions" class="suggestions"></div>
            </div>
            

            <button type="submit" class="find-btn">
                Find Route
            </button>

        </form>

    </div>
    <div>
        
    </div>
    <footer class="footer">
        <span>© 2026 MetroRasta</span>&nbsp; | &nbsp;
        <a href="/disclaimer">Disclaimer</a></footer>

</main>
<script src="/js/script.js"></script>
</body>
</html>
